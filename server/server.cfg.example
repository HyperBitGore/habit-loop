# Runtime
APP_ENV=development
LISTEN_ADDR=:8081
DATABASE_PATH=storage.db
WEB_ROOT=../web
APP_BASE_URL=http://localhost:8081

# Cloudflare Turnstile
TURNSTILE_SECRET=replace-with-widget-secret
TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# Email (required in production)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Habit Loop <no-reply@example.com>"

# HTTPS and reverse proxy
SECURE_COOKIES=false
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_CIDRS=

# Required only while creating the first administrator
# BOOTSTRAP_ADMIN_NAME=owner
# BOOTSTRAP_ADMIN_EMAIL=owner@example.com
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-password
